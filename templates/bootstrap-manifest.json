{
  "schema_version": 1,
  "policy": "all-new-projects",
  "standards_ref": "main",
  "repo_brain_ref": "main",
  "required_files": [
    {
      "source": "templates/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "templates/repo-standards.yml",
      "target": ".repo-standards.yml"
    },
    {
      "source": "templates/adopt-standards.yml",
      "target": ".github/workflows/ai-repo-map.yml"
    },
    {
      "source": "templates/project-state.md",
      "target": ".ai/project-state.md"
    },
    {
      "source": "templates/semantic-refresh.yml",
      "target": ".github/workflows/semantic-refresh.yml"
    }
  ],
  "required_capabilities": [
    "incremental-index",
    "ast-routing",
    "hotset",
    "context-packets",
    "compact-graph",
    "reverse-dependencies",
    "hash-cache",
    "session-state",
    "architecture-mermaid",
    "semantic-plan",
    "scip-semantic-index",
    "persistent-search-shards",
    "task-fingerprint-cache",
    "same-package-symbol-graph"
  ],
  "standards_version": 14
}
